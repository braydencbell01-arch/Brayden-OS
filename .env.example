# Frontend (Vite)
# Leave unset to use built-in demo fixtures with simulated live ticks.
# After deploying the worker, set this to the worker URL (no trailing slash).
VITE_FOOTBALL_API_BASE=

# Worker (Cloudflare) — set via:
#   cd worker && npx wrangler secret put API_FOOTBALL_KEY
# Get a free key at https://dashboard.api-football.com/register
# API_FOOTBALL_KEY=
